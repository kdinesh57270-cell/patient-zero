rules_version = '2';
// DRAFT rules for Patient Zero online rooms. Not tested against the Firebase emulator yet.
service cloud.firestore {
  match /databases/{db}/documents {
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.host == request.auth.uid
        // a player may only change their own entry and add chat lines
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'chat'])
            && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid]))
        // random rooms: a player can take over when the host disappeared
        || (resource.data.mode == 'r' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['host']))
      );

      // each player can read only their own secret doc; only the host writes them
      match /secret/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null
          && get(/databases/$(db)/documents/rooms/$(code)).data.host == request.auth.uid;
      }
    }
  }
}
